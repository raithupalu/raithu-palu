# =============================================================================
# Raithu Palu — Environment Configuration Example
# Copy the backend variables to `backend/.env` and frontend variables to `frontend/.env`.
# Never commit real `.env` files or credentials to version control.
# =============================================================================

# --- Backend Configuration (`backend/.env`) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# MongoDB Connection String (Required)
# IMPORTANT: Later financial phases require MongoDB multi-document ACID transactions.
# Use a MongoDB Atlas cluster or a self-managed replica set (standalone MongoDB does not support transactions).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/raithu_palu?retryWrites=true&w=majority

# Allowed CORS Origin(s) for Express (Required; comma-separated or *)
CORS_ORIGIN=http://localhost:5173

# Express JSON & URL-encoded body size limit
JSON_BODY_LIMIT=100kb

# MongoDB initial server selection timeout in milliseconds
DB_CONNECT_TIMEOUT_MS=5000

# JWT Authentication Configuration (Required; secret must be >= 32 characters)
JWT_SECRET=replace-with-a-cryptographically-strong-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Development/Test only fallback when MongoDB is unreachable (must be false in production)
ALLOW_IN_MEMORY_AUTH_FALLBACK=false

# --- Frontend Configuration (`frontend/.env`) ---
VITE_APP_NAME=Raithu Palu
VITE_APP_ENV=development
VITE_API_BASE_URL=/api
VITE_DEV_PORT=5173
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
